# Database (Supabase PostgreSQL)
# DATABASE_URL: runtime app connection via Supabase Transaction Pooler (port 6543)
# DIRECT_URL: direct connection for Prisma migrations/schema operations (port 5432)
DATABASE_URL="postgresql://postgres:password@db.project.supabase.co:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres:password@db.project.supabase.co:5432/postgres"

# Supabase
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# AI providers (optional)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
OPENAI_MODEL="gpt-4o"
ANTHROPIC_MODEL="claude-sonnet-4-20250514"
