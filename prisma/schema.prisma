// =============================================================
//  Pulse CRM — Data Schema
//  Workspace-isolated (every row carries workspaceId).
//  Targets Supabase PostgreSQL:
//    - uuid() IDs via pgcrypto
//    - Json / Json? map to jsonb in Postgres
//  All "list" fields are normalized to junction/mixin tables.
// =============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  schemas    = ["public", "auth"]
}

// ----------------------------------------------------------------
//  Identity & Workspace
// ----------------------------------------------------------------

model User {
  id        String   @id @default(uuid())
  authId    String?  @unique @db.Uuid
  email     String   @unique
  name      String
  avatarUrl String?
  jobTitle  String?
  locale    String   @default("en")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships   Membership[]
  notifications Notification[]
  activities    Activity[]
  ownedLeads    Lead[]         @relation("LeadOwner")
  assignedLeads Lead[]         @relation("LeadAssignee")
  ownedDeals    Deal[]         @relation("DealOwner")
  ownedTasks    Task[]         @relation("TaskOwner")
  assignedTasks Task[]         @relation("TaskAssignee")
  createdTasks  Task[]         @relation("TaskCreator")
  meetings      Meeting[]
  notes         Note[]
  apiKeys       ApiKey[]
  watchedTasks  TaskWatcher[]
  comments      Comment[]
  files         File[]
  auditLogs     AuditLog[]

  @@schema("public")
}

model Workspace {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String
  description String?
  logoUrl     String?
  accentColor String   @default("#6366f1")
  plan        String   @default("free") // free | pro | enterprise
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships          Membership[]
  pipelines            Pipeline[]
  contacts             Contact[]
  companies            Company[]
  leads                Lead[]
  deals                Deal[]
  tasks                Task[]
  notes                Note[]
  files                File[]
  activities           Activity[]
  notifications        Notification[]
  automations          Automation[]
  tags                 Tag[]
  entityTags           EntityTag[]
  customFields         CustomField[]
  auditLogs            AuditLog[]
  apiKeys              ApiKey[]
  events               CalendarEvent[]
  workspacePreferences WorkspacePreference[]

  @@schema("public")
}

model Membership {
  id          String    @id @default(uuid())
  userId      String
  workspaceId String
  role        String    @default("member") // owner | admin | member | viewer
  joinedAt    DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@schema("public")
}

// ----------------------------------------------------------------
//  CRM Core: Companies, Contacts, Leads, Deals
// ----------------------------------------------------------------

model Company {
  id          String   @id @default(uuid())
  workspaceId String
  name        String
  domain      String?
  industry    String?
  size        String? // "1-10" | "11-50" | ...
  revenue     Float?
  website     String?
  logoUrl     String?
  address     String?
  city        String?
  country     String?
  description String?
  status      String   @default("active") // active | inactive | churned
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace  Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contacts   Contact[]
  leads      Lead[]
  deals      Deal[]
  activities Activity[]
  notes      Note[]
  files      File[]

  @@schema("public")
}

model Contact {
  id          String   @id @default(uuid())
  workspaceId String
  companyId   String?
  firstName   String
  lastName    String
  email       String?
  phone       String?
  jobTitle    String?
  avatarUrl   String?
  linkedin    String?
  twitter     String?
  status      String   @default("subscribed") // subscribed | unsubscribed | bounced
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace  Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  company    Company?   @relation(fields: [companyId], references: [id], onDelete: SetNull)
  leads      Lead[]
  deals      Deal[]
  activities Activity[]
  notes      Note[]
  files      File[]
  meetings   Meeting[]

  @@schema("public")
}

model Lead {
  id              String    @id @default(uuid())
  workspaceId     String
  contactId       String?
  companyId       String?
  ownerId         String?
  fullName        String
  email           String?
  phone           String?
  source          String? // website | referral | ads | cold-outreach | event | other
  status          String    @default("new") // new | contacted | qualified | unqualified | proposal_sent | negotiation | won | lost | archived
  score           Int       @default(0) // 0-100
  estimatedValue  Float?
  expectedClose   DateTime?
  assignedUserId  String?
  lastActivityAt  DateTime?
  convertedDealId String?   @unique
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  workspace     Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact       Contact?   @relation(fields: [contactId], references: [id], onDelete: SetNull)
  company       Company?   @relation(fields: [companyId], references: [id], onDelete: SetNull)
  owner         User?      @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  assignedUser  User?      @relation("LeadAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)
  convertedDeal Deal?      @relation("ConvertedDeal", fields: [convertedDealId], references: [id], onDelete: SetNull)
  activities    Activity[]
  notes         Note[]
  files         File[]

  @@schema("public")
}

model Pipeline {
  id          String   @id @default(uuid())
  workspaceId String
  name        String
  description String?
  isDefault   Boolean  @default(false)
  stages      Stage[]
  deals       Deal[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@schema("public")
}

model Stage {
  id          String   @id @default(uuid())
  pipelineId  String
  name        String
  color       String   @default("#64748b")
  order       Int
  probability Int      @default(20) // 0-100
  isWon       Boolean  @default(false)
  isLost      Boolean  @default(false)
  pipeline    Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  deals       Deal[]

  @@schema("public")
}

model Deal {
  id            String    @id @default(uuid())
  workspaceId   String
  pipelineId    String
  stageId       String
  contactId     String?
  companyId     String?
  ownerId       String?
  title         String
  amount        Float     @default(0)
  currency      String    @default("INR")
  probability   Int       @default(20)
  expectedClose DateTime?
  closedAt      DateTime?
  closeReason   String? // won | lost
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  workspace     Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  pipeline      Pipeline   @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  stage         Stage      @relation(fields: [stageId], references: [id], onDelete: Cascade)
  contact       Contact?   @relation(fields: [contactId], references: [id], onDelete: SetNull)
  company       Company?   @relation(fields: [companyId], references: [id], onDelete: SetNull)
  owner         User?      @relation("DealOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  convertedFrom Lead?      @relation("ConvertedDeal")
  activities    Activity[]
  notes         Note[]
  files         File[]
  tasks         Task[]

  @@schema("public")
}

// ----------------------------------------------------------------
//  Tasks, Calendar, Notes, Files
// ----------------------------------------------------------------

model Task {
  id           String    @id @default(uuid())
  workspaceId  String
  dealId       String?
  title        String
  description  String?
  status       String    @default("todo") // todo | in_progress | done | canceled
  priority     String    @default("medium") // low | medium | high | urgent
  ownerId      String?
  assigneeId   String?
  creatorId    String?
  dueDate      DateTime?
  startDate    DateTime?
  recurrence   String? // none | daily | weekly | monthly
  parentTaskId String?
  order        Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  deal      Deal?         @relation(fields: [dealId], references: [id], onDelete: SetNull)
  owner     User?         @relation("TaskOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  assignee  User?         @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  creator   User?         @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  parent    Task?         @relation("SubtaskParent", fields: [parentTaskId], references: [id], onDelete: SetNull)
  subtasks  Task[]        @relation("SubtaskParent")
  comments  Comment[]
  watchers  TaskWatcher[]

  @@schema("public")
}

model TaskWatcher {
  id     String @id @default(uuid())
  taskId String
  userId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@schema("public")
}

model Comment {
  id        String   @id @default(uuid())
  taskId    String
  authorId  String
  body      String
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@schema("public")
}

model CalendarEvent {
  id          String   @id @default(uuid())
  workspaceId String
  title       String
  description String?
  type        String   @default("meeting") // meeting | call | task | reminder | out-of-office
  startAt     DateTime
  endAt       DateTime
  allDay      Boolean  @default(false)
  location    String?
  meetingLink String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  meetings  Meeting[]

  @@schema("public")
}

model Meeting {
  id        String   @id @default(uuid())
  eventId   String
  contactId String?
  hostId    String
  outcome   String? // scheduled | completed | canceled | no-show
  notes     String?
  createdAt DateTime @default(now())

  event   CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  contact Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  host    User          @relation(fields: [hostId], references: [id], onDelete: Cascade)

  @@schema("public")
}

model Note {
  id          String   @id @default(uuid())
  workspaceId String
  authorId    String
  leadId      String?
  contactId   String?
  dealId      String?
  companyId   String?
  title       String?
  body        String
  pinned      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  lead      Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  contact   Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  deal      Deal?     @relation(fields: [dealId], references: [id], onDelete: SetNull)
  company   Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  files     File[]

  @@schema("public")
}

model File {
  id          String   @id @default(uuid())
  workspaceId String
  uploaderId  String?
  noteId      String?
  leadId      String?
  contactId   String?
  dealId      String?
  companyId   String?
  name        String
  mimeType    String
  size        Int
  url         String
  version     Int      @default(1)
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  uploader  User?     @relation(fields: [uploaderId], references: [id], onDelete: SetNull)
  note      Note?     @relation(fields: [noteId], references: [id], onDelete: SetNull)
  lead      Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  contact   Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  deal      Deal?     @relation(fields: [dealId], references: [id], onDelete: SetNull)
  company   Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@schema("public")
}

// ----------------------------------------------------------------
//  Activity Log, Notifications, Tags, Custom Fields
// ----------------------------------------------------------------

model Activity {
  id          String   @id @default(uuid())
  workspaceId String
  actorId     String?
  leadId      String?
  contactId   String?
  dealId      String?
  companyId   String?
  type        String // created | updated | status_changed | note_added | file_uploaded | email_sent | call_logged
  summary     String
  meta        Json? // JSON
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor     User?     @relation(fields: [actorId], references: [id], onDelete: SetNull)
  lead      Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  contact   Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  deal      Deal?     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  company   Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@schema("public")
}

model Notification {
  id          String   @id @default(uuid())
  workspaceId String
  userId      String
  type        String // mention | assignment | automation | system
  title       String
  body        String?
  link        String?
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@schema("public")
}

model Tag {
  id          String   @id @default(uuid())
  workspaceId String
  name        String
  color       String   @default("#64748b")
  createdAt   DateTime @default(now())

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  entities  EntityTag[]

  @@unique([workspaceId, name])
  @@schema("public")
}

// Polymorphic tag binding (entityType discriminates: lead | contact | deal | company | task | note).
// entityId is intentionally NOT a FK — it's a polymorphic reference resolved at the app layer.
// Cascade deletes are handled in the data layer (delete EntityTag rows when an entity is removed).
model EntityTag {
  id          String   @id @default(uuid())
  workspaceId String
  tagId       String
  entityType  String // lead | contact | deal | company | task | note
  entityId    String
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tag       Tag       @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@schema("public")
}

model CustomField {
  id          String   @id @default(uuid())
  workspaceId String
  entityType  String // lead | contact | deal | company | task
  name        String
  key         String
  type        String // text | number | date | select | multiselect | boolean | url
  options     Json?
  required    Boolean  @default(false)
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, entityType, key])
  @@schema("public")
}

// ----------------------------------------------------------------
//  Automations + Audit + API Keys
// ----------------------------------------------------------------

model Automation {
  id            String    @id @default(uuid())
  workspaceId   String
  name          String
  description   String?
  enabled       Boolean   @default(true)
  triggerType   String // lead_created | lead_updated | deal_won | deal_lost | task_completed | task_assigned | pipeline_changed | status_changed | user_joined | csv_imported | contact_added | file_uploaded | workspace_created
  triggerConfig Json?
  // graph stored as JSON of nodes & edges (visual node editor)
  graph         Json
  runsCount     Int       @default(0)
  lastRunAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  logs      AutomationLog[]

  @@schema("public")
}

model AutomationLog {
  id           String   @id @default(uuid())
  automationId String
  status       String // success | failed | running
  detail       String?
  createdAt    DateTime @default(now())

  automation Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@schema("public")
}

model AuditLog {
  id          String   @id @default(uuid())
  workspaceId String
  actorId     String?
  action      String
  entityType  String
  entityId    String?
  meta        Json?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor     User?     @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@schema("public")
}

model ApiKey {
  id          String    @id @default(uuid())
  workspaceId String
  creatorId   String
  name        String
  prefix      String // first 8 chars
  hashedKey   String    @unique
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  creator   User      @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@schema("public")
}

// Workspace preferences (nav mode, feature flags, etc.)
model WorkspacePreference {
  workspaceId String   @id
  navMode     String   @default("sidebar") // sidebar | dock
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@schema("public")
}
